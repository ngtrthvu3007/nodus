// Generates tokens.css from tokens.ts (same folder) so Tailwind utilities use the exact colors antd derives.
// Run with `pnpm tokens` after changing tokens.ts.
import { writeFileSync } from "node:fs";
import antd from "antd";
import type { ThemeConfig } from "antd";
import { THEME_MODE, buildThemeConfig } from "./tokens.ts";

const { theme } = antd;

// CSS variable name (without the --nodus- prefix) → antd alias token
const TOKEN_MAP = {
  "color-primary": "colorPrimary",
  "color-primary-hover": "colorPrimaryHover",
  "color-primary-active": "colorPrimaryActive",
  "color-primary-soft": "colorPrimaryBg",
  "color-on-primary": "colorTextLightSolid",
  "color-success": "colorSuccess",
  "color-warning": "colorWarning",
  "color-error": "colorError",
  "color-info": "colorInfo",
  "color-link": "colorLink",
  "color-fg": "colorText",
  "color-fg-muted": "colorTextSecondary",
  "color-fg-subtle": "colorTextTertiary",
  "color-fg-disabled": "colorTextQuaternary",
  "color-surface": "colorBgContainer",
  "color-canvas": "colorBgLayout",
  "color-elevated": "colorBgElevated",
  "color-fill": "colorFillTertiary",
  "color-border": "colorBorder",
  "color-border-muted": "colorBorderSecondary",
  "radius-sm": "borderRadiusSM",
  "radius-md": "borderRadius",
  "radius-lg": "borderRadiusLG",
  "font-sans": "fontFamily",
  "font-mono": "fontFamilyCode",
  "font-size-sm": "fontSizeSM",
  "font-size": "fontSize",
  "font-size-lg": "fontSizeLG",
  "font-size-h1": "fontSizeHeading1",
  "font-size-h2": "fontSizeHeading2",
  "font-size-h3": "fontSizeHeading3",
} as const;

const toPx = (value: unknown) => (typeof value === "number" ? `${value}px` : String(value));

const buildBlock = (selector: string, config: ThemeConfig) => {
  const token = theme.getDesignToken(config);
  const lines = Object.entries(TOKEN_MAP).map(([name, key]) => `  --nodus-${name}: ${toPx(token[key])};`);
  return `${selector} {\n${lines.join("\n")}\n}`;
};

const css = [
  "/* Generated by shared/theme/buildTokens.mts from tokens.ts. Do not edit. */",
  buildBlock(":root", buildThemeConfig(theme, THEME_MODE.light)),
  buildBlock(`:root[data-theme="${THEME_MODE.dark}"]`, buildThemeConfig(theme, THEME_MODE.dark)),
  "",
].join("\n\n");

writeFileSync(new URL("./tokens.css", import.meta.url), css);
console.log("shared/theme/tokens.css written");
