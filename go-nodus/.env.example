# Local development defaults — `cp .env.example .env` works as-is with `docker compose up -d`.

# Postgres container (docker-compose.yml)
POSTGRES_USER=nodus
POSTGRES_PASSWORD=nodus
POSTGRES_DB=nodus
# Host port of the container. Uncomment and change it when 5432 is taken (a local Postgres); then use the same port in DATABASE_URL.
# POSTGRES_PORT=5434

# API and the migrate CLI (make migrate-*)
DATABASE_URL=postgres://nodus:nodus@localhost:5432/nodus?sslmode=disable
PORT=8080
# Origin of the frontend that calls the API from the browser (next-nodus dev server)
ALLOWED_ORIGIN=http://localhost:4000
